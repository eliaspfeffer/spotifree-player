[Unit]
Description=Password-protected Spotify song web server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/spotify-song-server
EnvironmentFile=/etc/spotify-song-server.env
ExecStart=/usr/bin/python3 /opt/spotify-song-server/app/music_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

